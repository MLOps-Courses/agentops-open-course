# Copy this file to `.env` at the repository root. Only explicit config,
# interactive, and live-evaluation tasks load it; install, check, and test tasks
# never inherit these values. Validate the result with `mise run config:check`,
# which masks secrets.
#
# This file is generated; run `mise run config:generate` instead of editing it.
# Variable names and defaults come from Config's Go tags. Learner guidance and
# deliberate opt-in or alternate values live in agents/go/config/env.example.tmpl.
# Config contract: {{ contract }}
#
# Each variable below lists: purpose — default — which learning path needs it.

# ── Account-free default: Ollama + Qwen3 (Chapters 2-4) ─────────────────────
# Which composition the server and CLI serve. The `workflow` and `coordinator`
# task aliases set this themselves — leave it alone for the default
# conversational agent. One of: agent, workflow, coordinator. Default: agent.
{{ setting "Entrypoint" false }}
# The provider names the ADK client contract, not the network topology. The
# default OpenAI-compatible adapter calls Ollama directly.
# One of: openai-compatible, gemini.
{{ setting "ModelProvider" true }}
{{ setting "Model" true }}
{{ setting "OpenAIBaseURL" true }}
# Non-secret marker required by the OpenAI SDK; Ollama ignores it.
{{ setting "OpenAIAPIKey" true }}
# Sampling temperature, 0 to 2. 0 lowers variance but cannot make a model run
# bit-reproducible; set it before comparing evaluation runs (Chapter 4.4).
# Unset preserves the provider default; 0 is the deliberate evaluation example.
{{ example "ModelTemperature" "0" false }}

# ── Governed local path: Ollama + agentgateway (Chapter 5) ──────────────────
# Start Ollama and `mise run gateway:host`, then change only the base URL. The
# application-side provider remains `openai-compatible`.
{{ alternate "OpenAIBaseURL" "http://127.0.0.1:4000/v1" false }}
# Route the six read/runbook tools through the governed gateway MCP listener
# (:3000) instead of in-process stdio. Unset = local stdio MCP.
{{ example "MCPURL" "http://127.0.0.1:3000/mcp" false }}
# Bearer token for a JWT/API-key-secured gateway MCP route (Chapter 5.5). Mint a
# demo token with `./infra/scripts/gateway-jwt.sh`. Unset for the open local route.
{{ setting "MCPToken" false }}
# When the secured gateway serves TLS with a self-signed cert, point the OpenAI
# SDK and clients at it so certificate verification succeeds. Agent tasks run
# from agents/go, so this path is relative to that working directory.
{{ external "SSL_CERT_FILE" "../../infra/agentgateway/host/auth/ca-cert.pem" false }}
# Header a trusted gateway sets after validating the JWT; its value becomes the
# audited approver identity (Chapter 5.5). Only set this when a gateway you
# trust strips the header from client requests. Unset keeps synthetic session
# and memory scoping; confirmation alone cannot authorize a guarded A2A action.
{{ example "TrustedIdentityHeader" "x-verified-subject" false }}

# ── Optional direct native Gemini / Vertex AI path ──────────────────────────
# These variables configure direct ADK provider calls. AI Studio uses
# GOOGLE_API_KEY; Vertex on your workstation uses Application Default
# Credentials. The GKE profile stays openai-compatible and owns its separate
# model and Workload Identity settings in the Kubernetes manifests.
{{ alternate "ModelProvider" "gemini" false }}
{{ alternate "Model" "gemini-3.6-flash" false }}
{{ setting "GoogleAPIKey" false }}
# The Config default is false; true is the deliberate Vertex example.
{{ example "GoogleGenAIUseEnterprise" "true" false }}
{{ example "GoogleCloudProject" "your-gcp-project-id" false }}
{{ example "GoogleCloudLocation" "global" false }}

# ── Data and A2A serving ─────────────────────────────────────────────────────
# Where the immutable seed dataset lives and where runtime state is copied.
# Both resolve against the working directory, which every `mise run` task in
# agents/go pins to the module root. Override only for containers.
{{ setting "DataDir" false }}
{{ setting "StateDir" false }}
# Where ADK's sessions live. `sqlite` keeps them in AGENT_STATE_DIR as one file
# with one writer — the account-free default that needs nothing installed.
# `postgres` moves them to a shared server so several replicas can serve the same
# conversation (Chapter 6.9). One of: sqlite, postgres. Default: sqlite.
{{ setting "SessionBackend" false }}
# Connection URL for the postgres backend, in the form
# postgres://user:password@host:5432/database?sslmode=disable. It stays empty
# here on purpose: this file is committed, and that URL carries a password.
# Supply it from your secret store, and leave it unset for the sqlite default.
{{ setting "SessionDSN" false }}
# Connections one replica may hold open against the postgres session store.
# Replicas multiplied by this value must stay under the server's own
# max_connections. Ignored by sqlite, which holds exactly one. Default: 10.
{{ setting "SessionMaxConns" false }}
# Advertised A2A address (what the agent card publishes) — the bind address is
# separate so host runs stay loopback-only. Kubernetes overrides the bind host
# to 0.0.0.0. Defaults: bind 127.0.0.1, advertise localhost:8080/http.
{{ setting "A2ABindHost" false }}
{{ setting "A2AHost" false }}
{{ setting "A2APort" false }}
{{ setting "A2AProtocol" false }}
# Upper bound on model calls a single A2A request may spend. Default: 12.
{{ setting "A2AMaxLLMCalls" false }}
# Token streaming is off because chunks weaken whole-message PII redaction.
{{ setting "A2AStreaming" false }}
# How long in-flight requests may drain after SIGTERM. Kubernetes'
# terminationGracePeriodSeconds must exceed this. Default: 10.
{{ setting "DrainTimeout" false }}

# ── Resilience (Chapter 4.5) ─────────────────────────────────────────────────
# Deadline for one model request, one governed MCP tool call, and the retry
# policy for transient failures. Guarded write actions are never retried.
{{ setting "ModelTimeout" false }}
{{ setting "ToolTimeout" false }}
{{ setting "MaxRetries" false }}
{{ setting "RetryBackoff" false }}
# Circuit breaker for idempotent read tools: off by default, so a failing tool
# is only retried. Enabling it stops calling a tool that keeps failing until the
# reset window elapses.
{{ setting "CircuitBreakerEnabled" false }}
{{ setting "CircuitFailureThreshold" false }}
{{ setting "CircuitResetTimeout" false }}
# Secondary model tried only after the primary fails every retry (Chapter 5.4).
# Unset means a model failure surfaces instead of being answered by a weaker
# model. Must differ from AGENT_MODEL. Default: unset; this is an opt-in example.
{{ example "ModelFallback" "qwen3:1.7b" false }}
# Emergency kill switch: freeze every guarded write while an incident is open
# (Chapter 7.7). Reads keep working. Default: false.
{{ setting "WritesDisabled" false }}
# Spotlight and neutralize prompt-injection markers in untrusted tool output.
# Default: true.
{{ setting "SanitizeToolOutput" false }}
# Layer-2 named-entity detection for agentgateway's private webhook. This URL
# must point directly to Ollama, never back through agentgateway, or the guard
# would recursively invoke itself. The deadline stays below the gateway's
# fixed 10-second webhook timeout.
{{ setting "PIIModel" false }}
{{ setting "PIIModelBaseURL" false }}
{{ setting "PIIModelEnabled" false }}
{{ setting "PIIModelTimeout" false }}
# Optional semantic retrieval through local Ollama embeddings. Keyword
# retrieval remains the deterministic default.
{{ setting "SemanticRetrieval" false }}
{{ setting "EmbeddingsURL" false }}
{{ setting "EmbeddingModel" false }}
# Cold-start deadline for the optional local embedding model (Chapter 3.4).
{{ setting "EmbeddingTimeout" false }}
# Bounded conversation history (Chapter 3.4). Unset sends ADK's full session
# history every turn; a value of at least 2 keeps only that many recent messages
# and replaces older ones with one compact note. Deterministic and model-free.
# This is an opt-in example; unset remains Config's default.
{{ example "MaxHistoryMessages" "40" false }}

# ── Token budgets and cost attribution (Chapter 7.3) ─────────────────────────
# Hard per-session token budget; unset disables enforcement. Prices are per
# 1000 tokens in your billing currency: keep 0 for local Ollama, set your
# provider's published rates for hosted models (no vendor pricing is hardcoded).
# This is an opt-in example; unset remains Config's default.
{{ example "MaxTokensPerSession" "50000" false }}
{{ setting "InputPricePer1K" false }}
{{ setting "OutputPricePer1K" false }}

# ── Self-hosted telemetry (Chapter 7) ────────────────────────────────────────
# OTLP export for metrics/logs and, only after explicit risk acceptance, ADK
# traces. The pinned ADK always records tool arguments, tool results, and raw
# exception text in spans, so false/unset/malformed forces trace sampling off.
# Set the ADK capture switch to the exact literal true only for synthetic lab
# data whose content may safely reach Tempo. The GenAI switch separately governs
# model-message log events and remains off by default.
{{ external "OTEL_EXPORTER_OTLP_ENDPOINT" "http://127.0.0.1:4318" false }}
{{ external "OTEL_EXPORTER_OTLP_PROTOCOL" "http/protobuf" false }}
{{ external "OTEL_SERVICE_NAME" "agentops-agent" false }}
{{ external "ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS" "false" false }}
{{ external "OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT" "false" false }}

# ── Evaluation judge (Chapter 4.4) ───────────────────────────────────────────
# Read by the evaluation harness, not by the agent. `mise run eval` scores every
# case deterministically and then asks a second model whether the answer holds up,
# so the harness needs its own model endpoint. These defaults point at the same
# account-free Ollama the agent uses; point them at the gateway model route on
# :4000 once Chapter 5 is running, and the judge is governed like any other caller.
{{ external "EVAL_JUDGE_BASE_URL" "http://127.0.0.1:11434/v1" true }}
{{ external "EVAL_JUDGE_MODEL" "qwen3:4b-instruct" true }}
{{ external "EVAL_JUDGE_API_KEY" "local-ollama" true }}
# One judge call carries the question, the answer, and the reference answer, so it is
# a larger prompt than the turn it grades. The harness allows five minutes unless you
# raise it, and on a CPU-only host that is not enough: the run fails on its first case.
# Size it from the inference line `mise run doctor:model` prints, as with the agent.
{{ external "EVAL_JUDGE_TIMEOUT_S" "1200" true }}
# Deadline for one whole agent turn, in seconds; unset keeps thirty minutes. A turn
# is a loop, not a call: a five-tool trajectory is six or seven model calls whose
# prompt grows at every step, and on a CPU-only host one turn can outlast the
# built-in deadline and fail a case that was working.
{{ external "EVAL_TURN_TIMEOUT_S" "5400" true }}

# ── Observability stack host ports (Chapter 7) ───────────────────────────────
# Read by infra/observability/compose.yaml, not by the agent. The defaults below
# are the inventory the course documents and the convention checker pins; set one
# only when a host port is already taken. Grafana is the asymmetric one: the
# variable is the host port, and the container always listens on 3000. Overriding
# a port does not rewrite the URLs printed in Chapter 7.
{{ external "TEMPO_PORT" "3200" false }}
{{ external "LOKI_PORT" "3100" false }}
{{ external "OTEL_GRPC_PORT" "4317" false }}
{{ external "OTEL_HTTP_PORT" "4318" false }}
{{ external "PROMETHEUS_PORT" "9090" false }}
{{ external "ALERTMANAGER_PORT" "9093" false }}
{{ external "GRAFANA_PORT" "3002" false }}
# The Compose default network is external and created by `mise run observability:up`;
# change the name only if it collides with another project on this host.
{{ external "AGENTOPS_GATEWAY_NETWORK" "agentops-host-gateway-net" false }}
